{
  "name": "easylens",
  "version": "0.1.5",
  "private": true,
  "description": "EasyLens: a tray eye lens that translates English under the cursor into Chinese.",
  "homepage": "https://allen-bot-ctl.github.io/EasyLens/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allen-bot-ctl/EasyLens.git"
  },
  "main": "electron/main.js",
  "author": "EasyLens",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "start:show": "electron . --show-on-launch",
    "test": "node --test tests/*.test.js",
    "test:ocr": "node scripts/ocr-self-test.js",
    "build": "electron-builder --linux dir",
    "dist": "electron-builder --linux AppImage",
    "smoke": "sh scripts/smoke-test.sh"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.nangua.EasyLens",
    "productName": "EasyLens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility",
      "executableName": "easylens",
      "artifactName": "EasyLens-${version}-linux-${arch}.${ext}",
      "icon": "electron/assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EasyLens-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "EasyLens-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSDesktopCaptureUsageDescription": "EasyLens 需要屏幕录制权限以识别鼠标指向的英文单词并进行翻译。",
        "NSScreenCaptureUsageDescription": "EasyLens 需要屏幕录制权限以识别鼠标指向的英文单词并进行翻译。"
      }
    }
  }
}
