{
  "name": "easylens",
  "version": "0.1.0",
  "private": true,
  "description": "EasyLens: a tray eye lens that translates English under the cursor into Chinese.",
  "main": "electron/main.js",
  "author": "EasyLens",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "start:show": "electron . --show-on-launch",
    "test": "node --test tests/*.test.js",
    "test:ocr": "node scripts/ocr-self-test.js",
    "build": "electron-builder --linux dir",
    "dist": "electron-builder --linux AppImage",
    "smoke": "sh scripts/smoke-test.sh"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.nangua.EasyLens",
    "productName": "EasyLens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility",
      "executableName": "easylens",
      "icon": "electron/assets/icon.png"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
